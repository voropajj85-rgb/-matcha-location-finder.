{
  "name": "matcha-bar-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop workspace for launching a Matcha Bar in Munich",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check electron/main.cjs && node --check js/workspace.js && node scripts/tests/workspace.test.js",
    "dist:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.6"
  },
  "build": {
    "appId": "de.matchabar.workspace",
    "productName": "Matcha Bar Workspace",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "data/**/*",
      "assets/**/*",
      "electron/**/*",
      "!scripts/ingest/reports/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Matcha-Bar-Workspace-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Matcha-Bar-Workspace-Portable-${version}-${arch}.${ext}"
    }
  }
}
